      "parameters": {
        "jsCode": "// Agrupa las filas por exec_id, ordena por idx, concatena los chunks y parsea el JSON\nconst rows = $input.all().map(i => i.json);\nconst byId = {};\nfor (const r of rows) {\n  const id = r.exec_id; if (!id) continue;\n  (byId[id] = byId[id] || []).push(r);\n}\nconst list = Object.entries(byId).map(([id, rs]) => {\n  rs.sort((a, b) => Number(a.idx) - Number(b.idx));\n  const full = rs.map(r => r.chunk).join(\"\");\n  let data = null; try { data = JSON.parse(full); } catch (e) {}\n  const meta = rs[0];\n  return { id, module: meta.modulo, ts: Date.parse(meta.fecha) || 0, label: meta.etiqueta || \"\", summary: meta.resumen || \"\", data };\n});\nlist.sort((a, b) => b.ts - a.ts);\nreturn [{ json: { historial: list } }];"
      },
